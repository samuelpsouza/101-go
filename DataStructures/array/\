type UnsortedArray[T any] struct {
  Array []T
  MaxSize int
  Size int
}

func (u *UnsortedArray[T]) insert(value T) error {
  if u.MaxSize >= len(u.Array) {
    return fmt.Errorf("The array is already full")
  }  

  u.Array[Size] = value
  u.Size += 1
}

func (u *UnsortedArray[T]) delete(index int) {
  if u.Size == 0 {
    return fmt.Errorf("Delete from an empty array")
  } else if index < 0 && index >= u.Size {
    return fmt.Errorf("Index %d out of range", index) 
  }

  u.Array[index] = u.Array[MaxSize - 1]
  u.Size -= 1 
}
